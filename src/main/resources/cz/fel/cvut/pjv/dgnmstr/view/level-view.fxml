<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cz.fel.cvut.pjv.dgnmstr.view.GameController">
   <Pane fx:id="canvasWrapper">
      <Canvas fx:id="gameCanvas" height="200.0" width="200.0" />
   </Pane>

   <BorderPane pickOnBounds="false">
      <top>
         <Button mnemonicParsing="false" text="Pause" BorderPane.alignment="TOP_LEFT">
            <BorderPane.margin>
               <Insets left="20.0" top="20.0" />
            </BorderPane.margin>
         </Button>
      </top>

      <bottom>
         <HBox alignment="BOTTOM_CENTER" spacing="100.0" BorderPane.alignment="CENTER">
            <ProgressIndicator progress="0.0">
               <HBox.margin>
                  <Insets bottom="40.0" left="40.0" />
               </HBox.margin>
            </ProgressIndicator>
            <ProgressBar fx:id="healthBar" prefWidth="200.0" progress="1.0" styleClass="health-bar">
               <HBox.margin>
                  <Insets bottom="40.0" right="40.0" />
               </HBox.margin>
            </ProgressBar>
         </HBox>
      </bottom>
   </BorderPane>

   <VBox fx:id="inventoryView" alignment="TOP_RIGHT" maxHeight="400.0" maxWidth="300.0" spacing="10.0" style="-fx-background-color: rgba(0, 0, 0, 0.8); -fx-padding: 20; -fx-background-radius: 10;" visible="false" StackPane.alignment="TOP_RIGHT">
      <padding>
         <Insets right="10.0" top="10.0" />
      </padding>
      <Label style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" text="Inventory" />
      <ListView fx:id="inventoryList" prefHeight="400.0" prefWidth="300.0" style="-fx-background-color: transparent; -fx-control-inner-background: #2b2b2b; -fx-text-fill: white;" />
   </VBox>
   <VBox fx:id="chestView" alignment="TOP_RIGHT" maxHeight="400.0" maxWidth="300.0" spacing="10.0" style="-fx-background-color: rgba(0, 0, 0, 0.8); -fx-padding: 20; -fx-background-radius: 10;" visible="false" StackPane.alignment="BOTTOM_RIGHT">
      <padding>
         <Insets bottom="10.0" right="10.0" />
      </padding>
      <Label style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" text="Chest" />
      <ListView fx:id="chestList" prefHeight="400.0" prefWidth="300.0" style="-fx-background-color: transparent; -fx-control-inner-background: #2b2b2b; -fx-text-fill: white;" />
   </VBox>

</StackPane>
